---
type Props = {
  percent: number;
  label?: string;
  size?: "sm" | "md";
};

const { percent, label, size = "sm" } = Astro.props;
---

<div class="flex items-center gap-2">
  <div
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={percent}
    aria-label={label ?? "Progress"}
    class:list={[
      "flex-1 overflow-hidden rounded-full bg-black/10 dark:bg-white/10",
      size === "md" ? "h-2.5" : "h-1.5",
    ]}
  >
    <div
      class:list={["h-full rounded-full", percent === 100 ? "bg-emerald-500" : "bg-primary"]}
      style={`width: ${percent}%`}
    >
    </div>
  </div>
  {label && <span class="shrink-0 text-xs tabular-nums">{label}</span>}
</div>
