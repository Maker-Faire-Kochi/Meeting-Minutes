---
import type { ActionItem } from "@lib/minutes";
import { assigneeNames } from "@lib/minutes";
import FormattedDate from "@components/FormattedDate.astro";
import { cn } from "@lib/utils";

type Props = {
  items: ActionItem[];
  /** Show which meeting each item came from (for the tracker). */
  showMeeting?: boolean;
};

const { items, showMeeting = false } = Astro.props;
---

<ul class="not-prose divide-y divide-black/10 rounded-lg border border-black/15 dark:divide-white/10 dark:border-white/20">
  {
    items.map((item) => (
      <li
        data-action-item
        data-done={item.done ? "true" : "false"}
        data-deadline={item.deadline}
        data-assignees={assigneeNames(item.assignee).join("|").toLowerCase()}
        data-search={`${item.task} ${item.assignee ?? ""} ${item.meeting.data.title}`.toLowerCase()}
        class="flex gap-3 px-4 py-3 text-sm"
      >
        <span
          aria-hidden="true"
          class={cn(
            "mt-0.5 grid size-4 shrink-0 place-content-center rounded-sm border text-[10px]",
            item.done
              ? "border-emerald-500 bg-emerald-500 text-white"
              : "border-black/30 dark:border-white/30",
          )}
        >
          {item.done && "✓"}
        </span>
        <div class="min-w-0 flex-1 space-y-1">
          <div class={cn("text-black dark:text-white", item.done && "line-through opacity-60")}>
            {item.task}
          </div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
            {item.assignee && <span>👤 {item.assignee}</span>}
            {item.deadlineText && (
              <span>
                📅 {item.deadline ? <FormattedDate date={new Date(item.deadline)} /> : item.deadlineText}
              </span>
            )}
            <span
              class={cn(
                "rounded-sm border px-1.5",
                item.done
                  ? "border-emerald-500/40 text-emerald-700 dark:text-emerald-300"
                  : "border-black/15 dark:border-white/20",
              )}
            >
              {item.status}
            </span>
            <span
              data-overdue-badge
              hidden
              class="rounded-sm border border-secondary/40 bg-secondary/10 px-1.5 text-secondary"
            >
              Overdue
            </span>
            {showMeeting && (
              <a href={`/blog/${item.meeting.id}`} class="underline underline-offset-2 hover:text-primary">
                {item.meeting.data.title}
              </a>
            )}
          </div>
        </div>
      </li>
    ))
  }
</ul>
