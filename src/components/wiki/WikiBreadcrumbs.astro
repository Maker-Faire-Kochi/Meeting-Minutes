---
import type { WikiNode } from "@lib/wiki";

type Props = {
  trail: WikiNode[];
};

const { trail } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1.5">
    {
      trail.map((node, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === trail.length - 1 ? (
            <span class="text-black dark:text-white">{i === 0 ? "Wiki" : node.title}</span>
          ) : node.entry ? (
            <a href={node.href} class="hover:text-primary">
              {i === 0 ? "Wiki" : node.title}
            </a>
          ) : (
            <span>{node.title}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
