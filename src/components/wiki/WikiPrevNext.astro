---
type Link = { href: string; title: string };

type Props = {
  prev?: Link;
  next?: Link;
  /** Labels for the two cards (defaults: Previous / Next). */
  labels?: [string, string];
};

const { prev, next, labels = ["Previous", "Next"] } = Astro.props;
const cardClass =
  "group relative flex flex-col rounded-lg border border-black/15 px-4 py-3 no-underline transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white";
---

<div class="not-prose grid grid-cols-2 gap-1.5 sm:gap-3">
  {
    prev ? (
      <a href={prev.href} class={`${cardClass} pl-10`}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="absolute left-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
        >
          <line
            x1="5"
            y1="12"
            x2="19"
            y2="12"
            class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
          />
          <polyline
            points="12 5 5 12 12 19"
            class="translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
          />
        </svg>
        <span class="text-xs">{labels[0]}</span>
        <span class="text-sm font-medium">{prev.title}</span>
      </a>
    ) : (
      <div class="invisible" />
    )
  }
  {
    next ? (
      <a href={next.href} class={`${cardClass} items-end pr-10 text-right`}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="absolute right-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
        >
          <line
            x1="5"
            y1="12"
            x2="19"
            y2="12"
            class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
          />
          <polyline
            points="12 5 19 12 12 19"
            class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
          />
        </svg>
        <span class="text-xs">{labels[1]}</span>
        <span class="text-sm font-medium">{next.title}</span>
      </a>
    ) : (
      <div class="invisible" />
    )
  }
</div>
